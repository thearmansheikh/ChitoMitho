# Supabase (Project Settings > API). Copy this file to .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The website's own address, used for the sitemap, canonical links, shared-link previews and redirects.
# Leave it out until you have your own domain: the site then uses its free Vercel address.
# When you connect a domain, set it to that address (for example https://yourdomain.com) and redeploy. See README "Connect your own domain".
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: old addresses that should redirect to NEXT_PUBLIC_SITE_URL (comma separated).
# LEGACY_HOSTS=old-domain.com
